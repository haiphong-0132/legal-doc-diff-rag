## CẤU HÌNH ENDPOINT
# Nếu chạy gộp tất cả trên 1 máy chủ, chỉ cần điền API_BASE_URL:
API_BASE_URL=https://livecam-eligibility-foreign-painting.trycloudflare.com

# Nếu tách riêng từng server:
# EMBED_API_URL=http://localhost:8000
# RERANK_API_URL=http://localhost:8001
# LLM_API_URL=http://localhost:8002

## CẤU HÌNH CHẾ ĐỘ CHẠY CHO LLM (OLLAMA vs NVIDIA API CO-HOST)
# LLM_MODE nhận một trong hai giá trị:
# - "remote": Gọi qua LLM_API_URL / API_BASE_URL tự host (mặc định)
# - "nvidia": Chạy qua integrate.api.nvidia.com với Qwen 80B siêu mạnh
LLM_MODE=remote

# Token API Key khi chạy chế độ "nvidia":
LLM_API_KEY=nvapi-your-key-here

# Tên mô hình LLM sử dụng (Ví dụ cho Nvidia):
LLM_MODEL_NAME=qwen/qwen3-next-80b-a3b-instruct
